{
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "init": {
    "darwin": "npm install -g rsrs-cli && rsrs doctor",
    "linux": "npm install -g rsrs-cli && rsrs doctor",
    "win32": "npm install -g rsrs-cli && rsrs doctor"
  },
  "status": {
    "darwin": "rsrs --json status",
    "linux": "rsrs --json status",
    "win32": "rsrs --json status"
  },
  "auth": {
    "darwin": "rsrs --json status",
    "linux": "rsrs --json status",
    "win32": "rsrs --json status"
  },
  "unAuth": {
    "darwin": "rsrs --json status",
    "linux": "rsrs --json status",
    "win32": "rsrs --json status"
  },
  "statusMatchJson": "\"command\":\"status\""
}
